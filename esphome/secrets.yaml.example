# Copy to secrets.yaml (git-ignored) and fill in. Shared by every node.
wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"

# Password for the hotspot a node opens when it cannot join Wi-Fi.
fallback_ap_password: "change-me"

# Encrypts Home Assistant API traffic and OTA firmware uploads.
# Generate with: openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"
